# --- Server ---
HOST=0.0.0.0
PORT=1337
# URL pública de Strapi en Railway (sin barra final). Ej: https://strapi-cwmc.up.railway.app
PUBLIC_URL=

# --- Secrets (regenerar para producción, no reutilizar los de local) ---
APP_KEYS="key1,key2"
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=

# --- Database ---
# Local: sqlite (default). En Railway: postgres
DATABASE_CLIENT=sqlite
# En Railway: pegar referencia ${{Postgres.DATABASE_URL}}
DATABASE_URL=
# En Railway: true / false (cert autofirmado de Railway)
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# --- Cloudinary (uploads en producción) ---
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=

# --- CORS (dominios autorizados a llamar a la API, separados por coma) ---
# Ej: https://landing-cwmc.vercel.app,https://www.cwmc.com
CORS_ORIGIN=*
